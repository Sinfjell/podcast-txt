# Copy to ops/.env.metrics (or $APP_DIR/.env.metrics) and chmod 600.
# Never commit the real file — it holds the Notion integration token
# and (optionally) a PostHog personal API key.

NOTION_TOKEN=secret_replace_me
NOTION_METRICS_DATABASE_ID=0d846d9fc2a4441ba5d542eb4e7609da

# PostHog health check (optional). Personal API key with query:read only.
# When unset/invalid the metrics upsert still runs; Notes gets one warning line.
# POSTHOG_PERSONAL_API_KEY=phx_replace_me
# POSTHOG_PROJECT_ID=283916
# POSTHOG_HOST=https://eu.posthog.com

# Optional overrides (defaults match production layout / app.py).
# APP_DIR=/var/www/vhosts/podskrift.nettsmed.dev/app
# PODSKRIFT_DB=/var/www/vhosts/podskrift.nettsmed.dev/app/data/podcast.db
# METRICS_SOURCE=cron
# TRIAL_MINUTES=60
# DRY_RUN=1
