# Copy to .env and fill in what you need. Unset optional keys stay off.

# Global trial key — costs you money when users have no BYOK key.
# OPENAI_API_KEY=sk-...

SECRET_KEY=change-me-in-production

# Comma-separated emails that may open /admin (case-insensitive). Default is
# sindrefjelle@gmail.com. Must also be logged in; everyone else gets 404.
# ADMIN_EMAILS=sindrefjelle@gmail.com

# Canonical public origin (set in production):
# PUBLIC_BASE_URL=https://podskrift.com

# DATABASE_URL=sqlite:///data/podcast.db

# Optional environment override (production|staging|test|dev). When unset,
# production is detected from the live host layout / PUBLIC_BASE_URL; CI,
# pytest, Cursor sandboxes and /tmp databases stay non-production. Analytics
# and Sentry only initialise when the resolved environment is production.
# PODSKRIFT_ENV=dev

# Error reporting (production only). Unset = off.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=   # optional; defaults to git HEAD when available

# Product analytics + session replay (PostHog EU Cloud). Unset = fully off
# (no client snippet, no server events, no network calls). Only used when
# the process resolves as production (see PODSKRIFT_ENV / runtime_env.py).
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com

# Remote MCP server at /mcp (ChatGPT / Claude / Cursor). Default off.
# MCP_ENABLED=0
# MCP_MAX_PER_WINDOW=60
# MCP_WINDOW_SECONDS=60
# OAuth 2.1 for ChatGPT / Claude.ai connectors (own AS; default off).
# Requires MCP_ENABLED=1 for /mcp itself; discovery + /oauth/* 404 until on.
# MCP_OAUTH_ENABLED=0
# OAUTH_REGISTER_MAX_PER_WINDOW=20
# OAUTH_REGISTER_WINDOW_SECONDS=3600
# OAUTH_TOKEN_MAX_PER_WINDOW=60
# OAUTH_TOKEN_WINDOW_SECONDS=60

# Transactional email via Mailgun EU (sending domain: podskrift.com). Default
# off — the app logs and no-ops until EMAIL_ENABLED=1 and the API key is set.
# EMAIL_ENABLED=0
# MAILGUN_API_KEY=key-...          # domain sending key
# MAILGUN_DOMAIN=podskrift.com     # default if unset
# MAILGUN_BASE_URL=https://api.eu.mailgun.net
# MAIL_FROM=Podskrift <hello@podskrift.com>
# # MAIL_REPLY_TO=                 # optional; hello@ replies are routed by Mailgun

# New-user trial A/B split (hash of user id → one of the minute variants).
# Default on. When off, new signups get NEW_USER_TRIAL_MINUTES and no variant.
# TRIAL_SPLIT_ENABLED=1
# TRIAL_SPLIT_VARIANTS=60,120
# NEW_USER_TRIAL_MINUTES=120

# Optional Stripe credit pack (300 min / $5). Unset = Buy hidden, webhook 404.
# Buy stays hidden unless BOTH secret key and webhook secret are set.
# Prefer a restricted key (rk_…) with Checkout Sessions Write (+ Charges/Refunds
# Read, Disputes Read if you handle refunds). Keep sandbox and live values
# separate — objects and webhook secrets do not carry across modes.
# STRIPE_SECRET_KEY=rk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...   # preferred; else inline $5.00 USD price_data
# STRIPE_API_VERSION=2026-08-26.dahlia
# STRIPE_MANAGED_PAYMENTS=1   # Stripe is merchant of record and remits VAT.
#                             # Enable Managed Payments in the Dashboard first.
# STRIPE_AUTOMATIC_TAX=0      # 1 to enable Stripe Tax on Checkout Sessions
# STRIPE_TAX_BEHAVIOR=inclusive
# STRIPE_TAX_CODE=txcd_10103000
# Abandoned Checkout recovery (same-day email after session expires).
# CHECKOUT_EXPIRES_HOURS=2
# CHECKOUT_RECOVERY_ENABLED=1
# CHECKOUT_PROMOTIONS_CONSENT_ENABLED=0  # US merchants only; keep off in NO/EU
# Also enable in Stripe Dashboard: Settings → Checkout and Payment Links →
# recovery emails, and add checkout.session.expired on the webhook endpoint.
