# Copy to .env and fill in what you need. Unset optional keys stay off.

# Global trial key — costs you money when users have no BYOK key.
# OPENAI_API_KEY=sk-...

SECRET_KEY=change-me-in-production

# Canonical public origin (set in production):
# PUBLIC_BASE_URL=https://podskrift.com

# DATABASE_URL=sqlite:///data/podcast.db

# Error reporting (production only). Unset = off.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Product analytics + session replay (PostHog EU Cloud). Unset = fully off
# (no client snippet, no server events, no network calls).
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com

# Optional Stripe credit pack (300 min / $5). Unset = Buy hidden, app runs fine.
# Checkout runs with Managed Payments (Stripe is merchant of record and remits
# VAT), so it must be enabled at dashboard.stripe.com/settings/managed-payments.
# Webhook endpoint /stripe/webhook needs: checkout.session.completed,
# checkout.session.async_payment_succeeded, charge.refunded. Create it with
# API version 2025-03-31.basil or later (older ones still work via
# currency_conversion, but basil+ is what the code is written against).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...   # optional; otherwise inline $5.00 USD price_data.
#                             # A dashboard Price needs tax code txcd_10105001
#                             # and "tax inclusive" set on it.
